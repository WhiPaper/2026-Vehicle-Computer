VEHICLE_SERIAL_DEVICE=/dev/serial/by-id/REPLACE_WITH_STABLE_DEVICE_ID
VEHICLE_NAMESPACE=
VEHICLE_CONFIG=/etc/vehicle-computer/vehicle.yaml
VC_SAFETY_CONFIG=/etc/vehicle-computer/safety.yaml
VEHICLE_CAMERA_ENABLED=true
VEHICLE_CAMERA_CONFIG=/etc/vehicle-computer/camera.yaml
# Select a dedicated domain that is shared only with approved vehicle controllers.
ROS_DOMAIN_ID=42
